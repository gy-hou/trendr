{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT:-$(pwd)}/runtimes/claude-code/hooks/session_start.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT:-$(pwd)}/runtimes/claude-code/hooks/stop_heartbeat.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT:-$(pwd)}/runtimes/claude-code/hooks/subagent_stop.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Read",
      "Write",
      "WebFetch",
      "WebSearch",
      "Agent"
    ]
  }
}
